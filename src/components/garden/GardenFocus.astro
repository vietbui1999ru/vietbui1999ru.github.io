---
import Section from "@/components/primitives/Section.svelte";
import SectionHeader from "@/components/primitives/SectionHeader.svelte";
import Chip from "@/components/primitives/Chip.svelte";
import ToolIcon from "./ToolIcon.svelte";
import { PROSE } from "@/design-system/prose";
import { getToolIconPath } from "@/lib/tool-icon";

// Astro, not Svelte: each area's body is Markdown rendered at build time, and
// Svelte would need {@html} to place it. Tools show an icon when one is mapped.
interface Props {
  areas?: { id: string; title: string; html: string; tools: string[] }[];
}

const { areas = [] } = Astro.props;
---

<Section id="focus" data-block="focus">
  <SectionHeader title="focus" />

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {
      areas.map((area) => (
        <article class="border-[1.5px] border-ink bg-paper-raised p-5 shadow-hard-sm">
          <h3 class="font-serif text-step-1 font-semibold text-ink">{area.title}</h3>
          <div class={`${PROSE} mt-3 max-w-none text-step-0`} set:html={area.html} />
          <ul class="mt-4 flex flex-wrap gap-2">
            {area.tools.slice(0, 4).map((tool) => {
              const path = getToolIconPath(tool);
              return (
                <li>
                  {path ? (
                    <span class="inline-flex items-center gap-1.5 border border-ink px-2 py-0.5 font-mono text-[0.68rem] text-ink">
                      <ToolIcon path={path} label={tool} />
                      {tool}
                    </span>
                  ) : (
                    <Chip tone="muted">{tool}</Chip>
                  )}
                </li>
              );
            })}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
