---
import { chipClass } from "@/components/primitives/Chip.svelte";
import type { LibraryShelf } from "@/lib/library-pages";

interface Props {
  shelves: LibraryShelf[];
  current?: string;
}

const { shelves, current } = Astro.props;
---

<nav aria-label="library categories" class="mb-10 flex flex-wrap gap-2" data-library-tabs>
  {
    shelves.map((shelf) => (
      <a
        href={`/library/${shelf.type}`}
        aria-current={shelf.type === current ? "page" : undefined}
        class={chipClass(shelf.type === current ? "grey" : "ink", false, "md")}
        data-library-tab={shelf.type}
      >
        {shelf.label}
        {!shelf.enabled && " (hidden)"}
      </a>
    ))
  }
</nav>
