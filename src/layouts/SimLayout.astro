---
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <title>{title} · Viet Bui Sim Lab</title>
  </head>
  <body class="m-0 min-h-screen overflow-hidden bg-black font-mono text-white antialiased">
    <slot />
  </body>
</html>
