---
import type { GetStaticPaths } from "astro";
import SimLayout from "@/layouts/SimLayout.astro";
import AppCanvasIsland from "@/scenes/engine/AppCanvasIsland";
import LevaPanel from "@/scenes/ui/LevaPanel";
import { SCENE_REGISTRY } from "@/scenes/registry";

export const getStaticPaths = (() =>
  Object.keys(SCENE_REGISTRY).map((name) => ({ params: { name } }))) satisfies GetStaticPaths;

const { name } = Astro.params;
const entry = SCENE_REGISTRY[name as keyof typeof SCENE_REGISTRY];
if (!entry) throw new Error(`Unknown sim: ${name}`);
---

<SimLayout title={entry.title}>
  <div class="sim-canvas">
    <AppCanvasIsland client:load />
  </div>
  <LevaPanel client:load />

  <div
    data-scene-id={name}
    data-playground="true"
    class="sim-playground-sentinel"
    aria-label={`${entry.title} simulation playground`}
  ></div>

  <div class="sim-toolbar">
    <a href="/" class="sim-control" aria-label="Back to portfolio home">← portfolio</a>
    <span class="sim-title">{entry.title}</span>
    <button id="sim-share-btn" class="sim-control" type="button" aria-label="Copy share URL">
      share
    </button>
  </div>
</SimLayout>

<style>
  .sim-canvas,
  .sim-playground-sentinel {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .sim-canvas {
    isolation: isolate;
  }

  .sim-playground-sentinel {
    pointer-events: none;
  }

  .sim-toolbar {
    position: fixed;
    inset: 1rem 1rem auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sim-title {
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
  }

  .sim-control {
    width: fit-content;
    pointer-events: auto;
    color: white;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .sim-control:last-child {
    justify-self: end;
  }

  .sim-control:hover,
  .sim-control:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: white;
    outline: none;
  }

  @media (max-width: 640px) {
    .sim-toolbar {
      grid-template-columns: 1fr 1fr;
    }

    .sim-title {
      display: none;
    }
  }
</style>

<script>
  const shareButton = document.getElementById("sim-share-btn");
  shareButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      shareButton.textContent = "copied";
    } catch {
      shareButton.textContent = "copy failed";
    }
    window.setTimeout(() => {
      shareButton.textContent = "share";
    }, 2000);
  });
</script>
