---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GardenBlocks from "@/components/garden/GardenBlocks.astro";
import { getCollection, getEntry } from "astro:content";
import { buildFeed } from "@/lib/garden-feed";
import { currentlyItems } from "@/lib/library-view";

// Home is a vault note: Site/Home.md lists its blocks, Site/Focus/* feeds the focus block.
// With no Site/ folder the page renders no blocks.
const home = await getEntry("site", "home");

const sites = await getCollection("site");
const areas = sites
  .filter((entry) => entry.id.startsWith("focus/"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    html: entry.rendered?.html ?? "",
    tools: entry.data.tools,
  }));

const blogs = await getCollection("blog");
const thoughts = await getCollection("thoughts");
const library = await getCollection("library");
// The feed block filters by `sources` and caps itself by `limit`, so the page passes every item.
const items = buildFeed(blogs, thoughts, Number.POSITIVE_INFINITY, library);
// The `currently` block renders only when Site/Home.md lists it.
const currently = currentlyItems(library, { dev: import.meta.env.DEV });
---

<BaseLayout enableInkAmbient={true}>
  {
    home && (
      <GardenBlocks
        note="Site/Home.md"
        blocks={home.data.blocks}
        body={home.rendered?.html ?? ""}
        context={{ areas, items, currently }}
      />
    )
  }
</BaseLayout>
