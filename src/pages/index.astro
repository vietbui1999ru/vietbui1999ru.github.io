---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PaperHero from "@/components/svelte/PaperHero.svelte";
import PaperAboutTeaser from "@/components/svelte/PaperAboutTeaser.svelte";
import PaperBlog from "@/components/svelte/PaperBlog.svelte";
import PaperProjects from "@/components/svelte/PaperProjects.svelte";
import PaperContact from "@/components/svelte/PaperContact.svelte";
import type { ProjectCardData } from "@/data/projectData";
import { getCollection } from "astro:content";
import { toSlug } from "@/lib/utils";

const blogPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => ({
    slug: toSlug(p.id),
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    draft: p.data.draft,
    tags: p.data.tags,
    cover: p.data.cover,
  }));

const projects: ProjectCardData[] = (
  await getCollection("projects", (p) => !p.data.draft)
)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.date,
    featured: entry.data.featured,
    badges: entry.data.badges,
    cover: entry.data.cover ?? entry.data.images?.[0],
    images: entry.data.images,
    links: entry.data.links,
    media:
      entry.data.media ??
      entry.data.images?.map((src, index) => ({
        kind: "image" as const,
        src,
        alt: `${entry.data.title} screenshot ${index + 1}`,
      })),
    status: entry.data.status,
    bodyHtml: entry.rendered?.html ?? "",
  }));
---

<BaseLayout enableInkAmbient={true}>
  <PaperHero />
  <PaperAboutTeaser />
  <PaperBlog posts={blogPosts} />
  <PaperProjects projects={projects.slice(0, 4)} client:load />
  <PaperContact />
</BaseLayout>
