---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UiLab from "@/components/ui-lab/UiLab.svelte";
import ProjectSortFixture from "@/components/ui-lab/ProjectSortFixture.svelte";
import TimelineRailFixture from "@/components/ui-lab/TimelineRailFixture.svelte";
import ReadingHighlightFixture from "@/components/ui-lab/ReadingHighlightFixture.svelte";
import GardenBlocks from "@/components/garden/GardenBlocks.astro";
import LibraryCollection from "@/components/library/LibraryCollection.svelte";
import { LIBRARY_CARD_FIXTURES } from "@/fixtures/library";
import { GARDEN_BLOCK_FIXTURES } from "@/fixtures/gardenBlocks";

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}
---

<BaseLayout>
  <UiLab client:load />
  <ProjectSortFixture client:load />
  <section class="px-4 py-8 md:px-8">
    <p>
      UI_LAB_PLACEHOLDER hover or tab to a wikilink:
      <a href="#" data-kind="thought" data-title="UI_LAB_PLACEHOLDER thought" data-preview="UI_LAB_PLACEHOLDER preview text for a thought note.">thought link</a>,
      <a href="#" data-kind="blog" data-title="UI_LAB_PLACEHOLDER post with cover" data-preview="UI_LAB_PLACEHOLDER preview with a cover image." data-cover="/blog-assets/building-a-vault-cms-pipeline/log_image.jpg">post link</a>,
      <a href="#" data-kind="project" data-title="UI_LAB_PLACEHOLDER project">project link</a>.
    </p>
  </section>
  <TimelineRailFixture client:load />
  <ReadingHighlightFixture client:load />
  <section class="px-4 py-8 md:px-8" data-ui-lab="library">
    <LibraryCollection type="book" items={LIBRARY_CARD_FIXTURES} client:load />
  </section>
  {
    Object.entries(GARDEN_BLOCK_FIXTURES).map(([id, fixture]) => (
      <GardenBlocks
        note={`ui-lab:${id}`}
        blocks={[{ block: id, ...fixture.props }]}
        body={fixture.body}
        context={fixture.context}
      />
    ))
  }
</BaseLayout>
