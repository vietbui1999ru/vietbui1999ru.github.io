---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UiLab from "@/components/ui-lab/UiLab.svelte";
import GardenBlocks from "@/components/garden/GardenBlocks.astro";
import { GARDEN_BLOCK_FIXTURES } from "@/fixtures/gardenBlocks";

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}
---

<BaseLayout>
  <UiLab client:load />
  {
    Object.entries(GARDEN_BLOCK_FIXTURES).map(([id, fixture]) => (
      <GardenBlocks
        note={`ui-lab:${id}`}
        blocks={[{ block: id, ...fixture.props }]}
        body={fixture.body}
        context={fixture.context}
      />
    ))
  }
</BaseLayout>
