---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectMedia from "@/components/patterns/ProjectMedia.svelte";
import { getCollection, render } from "astro:content";
import GardenToc from "@/components/garden/GardenToc.svelte";
import { tocEntries, tocVisible } from "@/lib/toc";
import PageHeader from "@/components/primitives/PageHeader.svelte";
import Chip from "@/components/primitives/Chip.svelte";
import InkLink from "@/components/primitives/InkLink.svelte";
import { PROSE } from "@/design-system/prose";

export async function getStaticPaths() {
  const entries = await getCollection("projects", (project) => !project.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
// The reading rail column shows only when the sidebar TOC would show.
const rail = tocVisible(tocEntries(headings));
const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout enableInkAmbient={true} katex={remarkPluginFrontmatter.math === "katex"}>
  <div class="page-container py-section">
    <article
      data-ink-obstacle="content"
      class:list={["mx-auto max-w-5xl", rail && "lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:items-start lg:gap-12"]}
    >
      {rail && <GardenToc headings={headings} sidebar client:load />}
      <div class="min-w-0">
      <PageHeader
        title={entry.data.title}
        kicker={`${entry.data.status} · ${formattedDate}`}
        description={entry.data.summary}
        back={{ href: "/projects", label: "projects" }}
      >
        {entry.data.badges && entry.data.badges.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {entry.data.badges.map((badge) => <Chip tone="raised">{badge}</Chip>)}
          </div>
        )}
      </PageHeader>

      <div data-ink-obstacle="prose" class={`${PROSE} max-w-reading`}>
        <Content />
      </div>

      <ProjectMedia media={entry.data.media ?? []} />

      {entry.data.links && entry.data.links.length > 0 && (
        <footer class="mt-10 flex flex-wrap gap-4 border-t border-journal-3 pt-5">
          {entry.data.links.map((link) => (
            <InkLink href={link.url} external>{link.icon}</InkLink>
          ))}
        </footer>
      )}
      </div>
    </article>
  </div>
</BaseLayout>
