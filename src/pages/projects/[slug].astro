---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectMedia from "@/components/patterns/ProjectMedia.svelte";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("projects", (project) => !project.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout>
  <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <a
      href="/projects"
      class="u-draw mb-10 inline-block font-mono text-step--1 uppercase tracking-wider text-journal-1 no-underline"
    >
      ← all projects
    </a>

    <article class="mx-auto max-w-5xl">
      <header class="mb-10 border-b-[1.5px] border-ink pb-8">
        <span class="mb-3 block font-mono text-step--1 uppercase tracking-wider text-journal-2">
          {entry.data.status} · {formattedDate}
        </span>
        <h1 class="mb-4 max-w-4xl font-serif text-step-3 font-semibold leading-tight tracking-tight text-ink">
          {entry.data.title}
        </h1>
        <p class="max-w-3xl text-step-0 leading-relaxed text-journal-1">{entry.data.summary}</p>
        {entry.data.badges && entry.data.badges.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {entry.data.badges.map((badge) => (
              <span class="border border-ink bg-paper-raised px-2.5 py-0.5 font-mono text-[0.68rem] tracking-wide text-ink">{badge}</span>
            ))}
          </div>
        )}
      </header>

      <div
        class="prose prose-neutral dark:prose-invert max-w-[76ch] prose-headings:font-serif prose-headings:text-ink prose-p:text-ink-soft prose-li:text-ink-soft prose-a:text-ink prose-pre:rounded-none prose-pre:border-[1.5px] prose-pre:border-ink"
      >
        <Content />
      </div>

      <ProjectMedia media={entry.data.media ?? []} />

      {entry.data.links && entry.data.links.length > 0 && (
        <footer class="mt-10 flex flex-wrap gap-4 border-t border-journal-3 pt-5">
          {entry.data.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="u-draw font-mono text-step--1 uppercase tracking-wider text-ink no-underline">
              {link.icon} ↗
            </a>
          ))}
        </footer>
      )}
    </article>
  </div>
</BaseLayout>
