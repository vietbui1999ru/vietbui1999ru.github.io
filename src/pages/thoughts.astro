---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { toSlug } from "@/lib/utils";
import { publishedNewestFirst } from "@/lib/thoughts";
import PageHeader from "@/components/primitives/PageHeader.svelte";
import Chip from "@/components/primitives/Chip.svelte";
import { PROSE } from "@/design-system/prose";

const entries = publishedNewestFirst(await getCollection("thoughts"));
const thoughts = await Promise.all(
  entries.map(async (entry) => ({
    id: toSlug(entry.id),
    date: entry.data.date,
    tags: entry.data.tags ?? [],
    Content: (await render(entry)).Content,
  })),
);

const monthFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
});
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const months = thoughts.reduce<
  Array<{ label: string; thoughts: typeof thoughts }>
>((groups, thought) => {
  const label = monthFormatter.format(thought.date);
  const group = groups.at(-1);

  if (group?.label === label) {
    group.thoughts.push(thought);
  } else {
    groups.push({ label, thoughts: [thought] });
  }

  return groups;
}, []);

const proseClass = `${PROSE} max-w-none`;
---

<BaseLayout enableInkAmbient={true}>
  <section class="mx-auto w-full max-w-reading px-gutter py-section">
    <PageHeader
      title="thoughts"
      kicker="stream"
      description="Small observations and things I am learning, collected as they happen."
      back={{ href: "/", label: "home" }}
    />

    {months.length > 0 ? (
      <div class="space-y-12">
        {months.map((month) => (
          <section aria-labelledby={`month-${month.label.replaceAll(" ", "-")}`}>
            <h2
              id={`month-${month.label.replaceAll(" ", "-")}`}
              class="label-mono mb-5 text-journal-2"
            >
              {month.label}
            </h2>
            <div class="border-t-[1.5px] border-ink">
              {month.thoughts.map(({ id, date, tags, Content }) => (
                <article id={id} class="border-b border-journal-3 py-7 scroll-mt-20">
                  <div class="label-mono mb-4 flex flex-wrap items-center gap-3 text-journal-2">
                    <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>
                    {tags.map((tag) => <Chip tone="muted">{tag}</Chip>)}
                  </div>
                  <div class={proseClass}>
                    <Content />
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="label-mono border-y border-journal-3 py-12 text-center text-journal-1">
        No thoughts published yet.
      </p>
    )}
  </section>
</BaseLayout>
