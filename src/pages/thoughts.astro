---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { toSlug } from "@/lib/utils";
import { publishedNewestFirst } from "@/lib/thoughts";

const entries = publishedNewestFirst(await getCollection("thoughts"));
const thoughts = await Promise.all(
  entries.map(async (entry) => ({
    id: toSlug(entry.id),
    date: entry.data.date,
    tags: entry.data.tags ?? [],
    Content: (await render(entry)).Content,
  })),
);

const monthFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
});
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const months = thoughts.reduce<
  Array<{ label: string; thoughts: typeof thoughts }>
>((groups, thought) => {
  const label = monthFormatter.format(thought.date);
  const group = groups.at(-1);

  if (group?.label === label) {
    group.thoughts.push(thought);
  } else {
    groups.push({ label, thoughts: [thought] });
  }

  return groups;
}, []);

const proseClass =
  "prose prose-neutral dark:prose-invert max-w-none " +
  "prose-headings:font-serif prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink " +
  "prose-p:text-ink-soft prose-li:text-ink-soft " +
  "prose-a:text-ink prose-a:underline prose-a:decoration-journal-2 prose-a:underline-offset-4 " +
  "prose-code:before:content-none prose-code:after:content-none " +
  "prose-code:rounded-none prose-code:px-1.5 prose-code:py-0.5 " +
  "prose-code:bg-journal-4 prose-code:text-ink prose-code:font-normal " +
  "prose-blockquote:border-ink prose-blockquote:text-ink-soft";
---

<BaseLayout enableInkAmbient={true}>
  <section class="mx-auto w-full max-w-[76ch] px-4 py-16 sm:px-6 md:py-20">
    <a href="/" class="u-draw mb-8 inline-block font-mono text-step--1 uppercase tracking-wider text-journal-1 no-underline">
      ← portfolio
    </a>

    <header class="mb-12 border-b-[1.5px] border-ink pb-8">
      <div class="mb-4 flex items-baseline gap-4">
        <span class="font-mono text-step--1 text-journal-2">stream</span>
        <span class="h-px min-w-12 flex-1 -translate-y-1 bg-journal-3"></span>
      </div>
      <h1 class="mb-3 font-serif text-step-3 font-semibold tracking-tight text-ink">thoughts</h1>
      <p class="max-w-prose text-step-0 leading-relaxed text-journal-1">
        Small observations and things I am learning, collected as they happen.
      </p>
    </header>

    {months.length > 0 ? (
      <div class="space-y-12">
        {months.map((month) => (
          <section aria-labelledby={`month-${month.label.replaceAll(" ", "-")}`}>
            <h2
              id={`month-${month.label.replaceAll(" ", "-")}`}
              class="mb-5 font-mono text-step--1 uppercase tracking-wider text-journal-2"
            >
              {month.label}
            </h2>
            <div class="border-t-[1.5px] border-ink">
              {month.thoughts.map(({ id, date, tags, Content }) => (
                <article id={id} class="border-b border-journal-3 py-7 scroll-mt-20">
                  <div class="mb-4 flex flex-wrap items-center gap-3 font-mono text-step--1 uppercase tracking-wider text-journal-2">
                    <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>
                    {tags.map((tag) => (
                      <span class="border border-journal-2 px-2 py-0.5 text-[0.64rem] tracking-wide text-journal-1">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <div class={proseClass}>
                    <Content />
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="border-y border-journal-3 py-12 text-center font-mono text-step--1 uppercase tracking-wider text-journal-1">
        No thoughts published yet.
      </p>
    )}
  </section>
</BaseLayout>
