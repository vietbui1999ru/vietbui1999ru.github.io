---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GardenBlocks from "@/components/garden/GardenBlocks.astro";
import PageHeader from "@/components/primitives/PageHeader.svelte";
import InkLink from "@/components/primitives/InkLink.svelte";
import { getEntry, render } from "astro:content";

// About is a vault note: Site/About.md lists its blocks and holds the prose.
const about = await getEntry("site", "about");
const { headings = [] } = about ? await render(about) : {};
---

<BaseLayout enableInkAmbient={true}>
  <div class="page-container pt-section">
    <PageHeader title="about" kicker="profile" back={{ href: "/", label: "home" }} />
  </div>
  {
    about && (
      <GardenBlocks
        note="Site/About.md"
        blocks={about.data.blocks}
        body={about.rendered?.html ?? ""}
        context={{ headings }}
      />
    )
  }
  <div class="page-container pb-section">
    <InkLink href="/gallery" arrow="forward">gallery</InkLink>
  </div>
</BaseLayout>
