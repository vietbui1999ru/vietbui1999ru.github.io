---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PaperAbout from "@/components/svelte/PaperAbout.svelte";
import PaperExperience from "@/components/svelte/PaperExperience.svelte";
import PaperEducation from "@/components/svelte/PaperEducation.svelte";
import PageHeader from "@/components/primitives/PageHeader.svelte";
import { ABOUT_TAGLINE } from "@/data/aboutData";
---

<BaseLayout enableInkAmbient={true}>
  <div class="page-container pt-section">
    <PageHeader title="about" kicker="profile" description={ABOUT_TAGLINE} back={{ href: "/", label: "home" }} />
  </div>
  <PaperAbout client:load />
  <PaperExperience />
  <PaperEducation />
</BaseLayout>
