---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import PaperBlogVariants from "@/components/svelte/PaperBlogVariants.svelte";
import PaperTableOfContents from "@/components/svelte/PaperTableOfContents.svelte";
import { GiscusComments } from "@/components/blog/GiscusComments";
import { toSlug } from "@/lib/utils";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const entrySlug = toSlug(entry.id);

// Match variants by slugified id — variant files store parent_slug as a slug,
// while entry.id is the raw filename (may contain spaces/special chars).
const allVariants = await getCollection("blog-variants", (v) =>
  v.data.parent_slug === entrySlug || v.data.parent_slug === entry.id
);

// Render each variant's Content component for use in the template below
const renderedVariants = await Promise.all(
  allVariants.map(async (v) => {
    const { Content: VC } = await render(v);
    return { label: v.data.style_label, Content: VC };
  })
);

// Ensure AI variant is second if present (after Original)
const aiIdx = renderedVariants.findIndex((v) => v.label.toLowerCase() === "ai");
if (aiIdx > 0) {
  const [aiVariant] = renderedVariants.splice(aiIdx, 1);
  renderedVariants.unshift(aiVariant);
}

const storageId = "blog-variant-storage";

const wordCount = (entry.body ?? "").trim().split(/\s+/).length;
const readingTime = `${Math.max(1, Math.round(wordCount / 200))} min read`;
const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const proseClass =
  "prose prose-neutral dark:prose-invert max-w-none " +
  "prose-headings:font-serif prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink " +
  "prose-p:text-ink-soft prose-li:text-ink-soft " +
  "prose-a:text-ink prose-a:underline prose-a:decoration-journal-2 prose-a:underline-offset-4 " +
  "prose-code:before:content-none prose-code:after:content-none " +
  "prose-code:rounded-none prose-code:px-1.5 prose-code:py-0.5 " +
  "prose-code:bg-journal-4 prose-code:text-ink prose-code:font-normal " +
  "prose-pre:rounded-none prose-pre:border-[1.5px] prose-pre:border-ink " +
  "prose-blockquote:border-ink prose-blockquote:text-ink-soft";
---

<BaseLayout>
  <div class="mx-auto w-full max-w-7xl px-4 pt-12 pb-20 sm:px-6 md:pt-16 md:pb-24">
    <a
      href="/blog"
      class="u-draw mb-10 inline-block font-mono text-step--1 uppercase tracking-wider text-journal-1 no-underline"
    >
      ← field notes
    </a>

    <!--
      Hidden storage lives outside #blog-content so TableOfContents
      doesn't find duplicate headings from every pre-rendered variant.
    -->
    <div id={storageId} style="display:none" aria-hidden="true">
      <div data-variant-label="Original">
        <Content />
      </div>
      {renderedVariants.map(({ label, Content: VC }) => (
        <div data-variant-label={label}>
          <VC />
        </div>
      ))}
    </div>

    <div class="xl:grid xl:grid-cols-[210px_minmax(0,76ch)] xl:gap-12 xl:items-start">
      <aside class="hidden xl:block">
        <div class="sticky top-20 border-l-[1.5px] border-ink pl-4">
          <PaperTableOfContents contentId="blog-content" client:load />
        </div>
      </aside>
      <div id="blog-content" class="min-w-0">
        <header class="mb-12 border-b-[1.5px] border-ink pb-8">
          <span class="mb-4 block font-mono text-step--1 uppercase tracking-wider text-journal-2">field note</span>
          <h1 class="mb-4 font-serif text-step-3 font-semibold leading-tight tracking-tight text-ink">
            {entry.data.title}
          </h1>
          <p class="mb-5 text-step-0 leading-relaxed text-journal-1">
            {entry.data.description}
          </p>
          <div class="flex flex-wrap items-center gap-3 font-mono text-step--1 uppercase tracking-wider text-journal-2">
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
            {readingTime && <span>·</span>}
            {readingTime && <span>{readingTime}</span>}
            {entry.data.updated && (
              <>
                <span>·</span>
                <span>
                  Updated{" "}
                  {entry.data.updated.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
              </>
            )}
          </div>
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <span class="border border-ink bg-paper-raised px-2.5 py-0.5 font-mono text-[0.68rem] tracking-wide text-ink">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <PaperBlogVariants
          storageId={storageId}
          proseClass={proseClass}
          client:load
        />

        <GiscusComments client:visible />
      </div>
    </div>
  </div>
</BaseLayout>
