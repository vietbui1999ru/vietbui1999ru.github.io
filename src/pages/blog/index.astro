---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { toSlug } from "@/lib/utils";
import PaperBlogArchive from "@/components/svelte/PaperBlogArchive.svelte";
import type { SerializedPost } from "@/data/blogData";

const posts: SerializedPost[] = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    slug: toSlug(p.id),
    title: p.data.title,
    description: p.data.description ?? "",
    date: p.data.date.toISOString(),
    tags: p.data.tags ?? [],
    cover: p.data.cover,
  }));
---

<BaseLayout enableInkAmbient={true}>
  <PaperBlogArchive posts={posts} client:load />
</BaseLayout>
